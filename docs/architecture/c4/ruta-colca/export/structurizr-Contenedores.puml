@startuml
title <size:24>Diagrama de contenedores de RutaColca - base</size>\n<size:24>Diagrama de contenedores de RutaColca - base</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Software System,Externo", $bgColor="#8c8c8c", $borderColor="#626262", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Almacen", $bgColor="#0e7d73", $borderColor="#095750", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#0b3d62", $borderColor="#072a44", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#0e7d73", $borderColor="#095750", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#124161", $fontColor="#124161", $shadowing="", $borderStyle="solid")

Person(Turista, "Turista", $descr="Busca tours y reserva una salida al Colca.", $tags="Person", $link="")
Person(Operadordeagencia, "Operador de agencia", $descr="Publica tours y registra reservas presenciales.", $tags="Person", $link="")
Person(Guíadeturismo, "Guía de turismo", $descr="Recibe el itinerario y la lista del grupo por WhatsApp.", $tags="Person", $link="")
Person(Administrador, "Administrador", $descr="Aprueba agencias y consulta reportes de ventas.", $tags="Person", $link="")
System(Pasareladepagos, "Pasarela de pagos", $descr="Procesa tarjetas y billeteras; devuelve una referencia y el resultado del pago.", $tags="Software System,Externo", $link="")
System(WhatsAppBusiness, "WhatsApp Business", $descr="Entrega al guía el itinerario y la lista del grupo.", $tags="Software System,Externo", $link="")
System(SistemadeAUTOCOLCA, "Sistema de AUTOCOLCA", $descr="Valida el número del boleto turístico mediante una API HTTPS supuesta para el caso.", $tags="Software System,Externo", $link="")

System_Boundary("RutaColca_boundary", "RutaColca", $tags="Software System") {
  Container(RutaColca.Webdelturista, "Web del turista", $techn="React (SPA)", $descr="Permite buscar tours, registrar el boleto y solicitar una reserva.", $tags="Container", $link="")
  Container(RutaColca.Portaldeagencias, "Portal de agencias", $techn="React (PWA)", $descr="Gestiona tours y reservas; incluye acceso del administrador según su rol.", $tags="Container", $link="")
  Container(RutaColca.APIdeRutaColca, "API de RutaColca", $techn="Java 21 / Spring Boot", $descr="Gestiona cupos, valida boletos, coordina pagos y programa avisos.", $tags="Container", $link="")
  ContainerDb(RutaColca.Basededatos, "Base de datos", $techn="PostgreSQL 16", $descr="Guarda agencias, tours, salidas, reservas y referencias de pago.", $tags="Container,Almacen", $link="")
}

Rel(WhatsAppBusiness, Guíadeturismo, "Entrega el itinerario y la lista del grupo a", $techn="", $tags="Relationship", $link="")
Rel(Turista, RutaColca.Webdelturista, "Busca tours y solicita reservas en", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Operadordeagencia, RutaColca.Portaldeagencias, "Publica tours y registra reservas en", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Administrador, RutaColca.Portaldeagencias, "Aprueba agencias y consulta ventas en", $techn="HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.Webdelturista, RutaColca.APIdeRutaColca, "Solicita disponibilidad, validación y pago a", $techn="JSON/HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.Portaldeagencias, RutaColca.APIdeRutaColca, "Gestiona tours y sincroniza solicitudes al recuperar conexión con", $techn="JSON/HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, RutaColca.Basededatos, "Consulta cupos y guarda reservas y referencias de pago en", $techn="JDBC/TLS", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, SistemadeAUTOCOLCA, "Valida el número del boleto en", $techn="JSON/HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, Pasareladepagos, "Crea órdenes de cobro y consulta su estado en", $techn="JSON/HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.Webdelturista, Pasareladepagos, "Abre el formulario de pago alojado en", $techn="HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, WhatsAppBusiness, "Envía el itinerario y la lista un día antes mediante", $techn="JSON/HTTPS", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml